<Slide style={{ width: '1280px', height: '720px', background: '#0B1220', padding: '20px 64px' }}>
  <Box style={{ height: 100, borderLeft: '6px solid #38BDF8', paddingLeft: 18, justifyContent: 'center' }}>
    <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#E5EDF7' }}>CANoe AI Package（AI 软件包）</Text>
  </Box>
  <Box style={{ height: 540, flexDirection: 'row', gap: 32, alignItems: 'stretch' }}>
    <Box style={{ width: '54%', flexDirection: 'column', gap: 12 }}>
      <Box style={{ height: 348, background: '#16203A', borderRadius: 12, padding: 12, justifyContent: 'center' }}>
        <Image src="assets/ai_package.png" style={{ width: '100%', height: '100%', objectFit: 'contain' }} />
      </Box>
      <Box style={{ flex: 1, background: '#16203A', borderRadius: 12, padding: 16, justifyContent: 'center' }}>
        <Text style={{ fontSize: 16, color: '#94A3B8', lineHeight: 1.5 }}>图：CANoe AI Package = 代理 + 技能 + 预配置 MCP 服务器，以插件形式提供，兼容 CANoe 20 SP2。</Text>
      </Box>
    </Box>
    <Box style={{ width: '46%', gap: 14, justifyContent: 'space-between' }}>
      <Box style={{ background: '#16203A', borderRadius: 12, padding: 18, borderTop: '3px solid #38BDF8' }}>
        <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#38BDF8' }}>代理 Agents</Text>
        <Text style={{ fontSize: 16, color: '#94A3B8', lineHeight: 1.5, marginTop: 6 }}>为特定任务预定义的专职角色（如编码代理，经 MCP 用 CANoe 编译核验）。</Text>
      </Box>
      <Box style={{ background: '#16203A', borderRadius: 12, padding: 18, borderTop: '3px solid #38BDF8' }}>
        <Text style={{ fontSize: 22, fontWeight: 'bold', color: '#38BDF8' }}>技能 Skills</Text>
        <Text style={{ fontSize: 16, color: '#94A3B8', lineHeight: 1.5, marginTop: 6 }}>约 20 个跨代理共享的领域专长（如"如何用 C#/Python 写 CAPL"）。</Text>
      </Box>
      <Box style={{ background: '#16203A', borderRadius: 12, padding: 18, borderTop: '3px solid #F97316' }}>
